# Copy to .env and fill in. Every value is optional.

# dev defaults wc2026pass / admin; leave commented to use them, an empty value overrides them
# NEO4J_PASSWORD=
# GRAFANA_ADMIN_PASSWORD=

# LLM
# OLLAMA_CONCURRENCY=1        # concurrent local generations
# GROQ_API_KEY=               # only for the RAGAS judge (eval/eval_generation_ragas.py)

# optional
TRIGGER_TOKEN=
ODDS_API_KEY=
MASTODON_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
