# Copy to .env and fill in. docker-compose refuses to start without the
# four secrets below. Generate each with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"

# ── Required by docker-compose ───────────────────────────────────────────
REDIS_PASSWORD=
WEAVIATE_API_KEY=
NEO4J_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Running the API outside compose against those services:
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# ── LLM ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=
# OLLAMA_CONCURRENCY=1        # concurrent local generations
# GROQ_CONCURRENCY=2          # concurrent Groq requests
# GROQ_MIN_INTERVAL_S=2.0     # spacing between Groq requests (~30/min)

# ── Optional ─────────────────────────────────────────────────────────────
TRIGGER_TOKEN=
ODDS_API_KEY=
API_SPORTS_KEY=
ZAFRONIX_API_KEY=
MASTODON_ACCESS_TOKEN=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
LANGSMITH_API_KEY=
